# ==============================================================================
# Evalora Environment Configuration
# ==============================================================================
APP_ENV=development
DEBUG=0

# Database (MongoDB for FastAPI Docker stack)
MONGODB_URI=mongodb://root:example@mongo:27017/evaluai?authSource=admin
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=example

# Authentication (generate with: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_HEX_CHARACTERS

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Providers (Server-side only — never expose in frontend code)
AI_PROVIDER=gemini
AI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=MY_GEMINI_API_KEY
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Frontend API URL (use /api behind reverse proxy or http://localhost:8000 locally)
REACT_APP_API_URL=/api

# AI Studio Hosted App URL (injected automatically in AI Studio)
APP_URL=MY_APP_URL
